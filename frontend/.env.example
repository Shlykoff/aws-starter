# Copy to .env.local and fill in the values from `terraform output` (infra/).
# All five are public identifiers, not secrets: they end up in the browser bundle anyway.
# Never put a client secret or any credential in a VITE_* variable.

# Region of the Cognito user pool and the API (an AWS region name).
VITE_AWS_REGION=eu-north-1
# User pool ID, format <region>_<random>.
VITE_COGNITO_USER_POOL_ID=eu-north-1_EXAMPLE
# App client ID of the user pool (public client, no secret).
VITE_COGNITO_CLIENT_ID=exampleclientid1234567890
# Hosted UI base URL (the Cognito domain), no trailing slash.
VITE_COGNITO_HOSTED_UI_URL=https://example-domain.auth.eu-north-1.amazoncognito.com
# API Gateway base URL with the stage, no trailing slash. The app appends /requests.
VITE_API_URL=https://example123.execute-api.eu-north-1.amazonaws.com/v1
