# Copy to terraform.tfvars (git-ignored) and fill in.

# Hosted UI domain prefix: https://<prefix>.auth.eu-north-1.amazoncognito.com
# Must be unique across all AWS accounts in the region, so add something of your own.
# Lowercase letters, digits and hyphens; must not contain "aws", "amazon" or "cognito".
cognito_domain_prefix = "starter-dev-x7k2q9"

# Receives the request-status notices (failed and rejected requests) and the alarms.
# Two SNS subscriptions are created; each sends a confirmation mail, and the link in it must
# be clicked (an unconfirmed subscription receives nothing). In CI the value comes from a
# GitHub secret, passed as TF_VAR_notification_email.
notification_email = "you@example.com"

# The recipient of the messages: another system, outside this stack (contracts/partner-api.md).
# Base URL: https://<host>[:<port>], no trailing slash, no path (the worker appends /v1/submissions).
# In CI the value comes from the GitHub variable PARTNER_URL, passed as TF_VAR_partner_url.
partner_url = "https://partner.example.com"

# partner_api_key is deliberately NOT set here. It is the secret the recipient checks (header
# X-API-Key), at least 16 characters. It is an ephemeral variable: Terraform never writes it to
# the state or to a plan file, so it has to be given again on every plan and every apply. Best
# pass it as an environment variable, so that it is not in a file:
#   export TF_VAR_partner_api_key='...'
# In CI it is the GitHub secret PARTNER_API_KEY, passed as TF_VAR_partner_api_key.

# Rotating the API key: give the new value (see above) AND raise this number by one. Terraform
# cannot compare the key with what is stored, so it re-sends it only when the number changes.
# partner_api_key_version = 1

# webhook_token is deliberately NOT set here either. It is the secret the recipient signs its
# webhook calls with (contracts/webhook-api.md), at least 16 characters. The recipient is given
# the same value out of band, together with the webhook_url output. Ephemeral like the API key:
# give it again on every plan and every apply, best as an environment variable:
#   export TF_VAR_webhook_token='...'
# In CI it is the GitHub secret PARTNER_WEBHOOK_TOKEN, passed as TF_VAR_webhook_token.

# Rotating the webhook token: give the new value (see above) AND raise this number by one, as
# for the API key.
# webhook_token_version = 1

# optional
# project                = "aws-starter"
# env                     = "dev"
# region                  = "eu-north-1"
# backend_dist_dir        = "../../../backend/dist"   # build output, relative to this directory
# enable_static_site      = true                      # false = no S3 + CloudFront (API and Cognito only)
