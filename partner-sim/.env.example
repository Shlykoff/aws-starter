# Copy to `.env` (same folder as docker-compose.yml) to change a value. Every line is optional:
# without a .env file, docker-compose.yml uses the DEMO values written in it.
#
# The values below are DEMO values. They are public (they are in this repository), so they
# protect nothing. Change the key and the password before the service can be reached by
# anyone but you: on a server, or through the ngrok tunnel.

# Host port the service is published on, and the address it listens on there.
# 127.0.0.1 = this computer only. Use 0.0.0.0 to serve other computers (and change the key).
PARTNER_PORT=8080
PARTNER_BIND=127.0.0.1

# The key senders put in the X-API-Key header.
PARTNER_API_KEY=demo-key-change-me

# The login of the web interface (the inbox).
UI_USER=demo
UI_PASSWORD=demo-password-change-me

LOG_LEVEL=INFO

# OPTIONAL, both or neither: the client's side. With both set, an accepted message gets
# "Approve" / "Decline" buttons that send a signed DecisionEvent to the sender's webhook.
# The address of the sender's webhook: <api_url>/webhooks/partner of the main system's stack.
# https:// only (http:// is allowed for localhost, 127.0.0.1, [::1] and host.docker.internal).
WEBHOOK_URL=
# The shared token, at least 16 characters, the SAME value the sender holds (for example made
# with `openssl rand -hex 32`). A real secret: the value goes only into the git-ignored .env.
WEBHOOK_TOKEN=

# Only for the optional tunnel: `docker compose --profile tunnel up`.
# The token is on https://dashboard.ngrok.com/get-started/your-authtoken (a real secret: keep
# .env out of git). The domain is the one ngrok gives your account, e.g. something.ngrok-free.app
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
